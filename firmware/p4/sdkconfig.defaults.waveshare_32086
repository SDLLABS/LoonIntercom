CONFIG_IDF_TARGET="esp32p4"
CONFIG_P4_BOARD_WAVESHARE_ESP32_P4_ETH_32086=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
# ESP-IDF v5.5.4 ROM flash implementation cannot address >=32 MB.
# CONFIG_SPI_FLASH_ROM_IMPL is not set
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_waveshare_32mb.csv"
CONFIG_SPIRAM=y
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_ETH_PHY_INTERFACE_RMII=y
# No silicon revision here: add the overlay matching chip marking or boot log.
# No SDMMC, FAT, SPIFFS or filesystem is needed for boot or normal runtime.
